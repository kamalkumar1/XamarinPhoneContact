<?xml version="1.0" encoding="utf-8" ?>
<CollectionView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:model="clr-namespace:XamarinPhoneContact.Helper"
                xmlns:local="clr-namespace:XamarinPhoneContact.View"
                x:Class="XamarinPhoneContact.View.ContactCollectionView"
                SelectionMode="Single"
                VerticalScrollBarVisibility="Never"
                RemainingItemsThreshold="5">
  <CollectionView.ItemsLayout>
    <LinearItemsLayout ItemSpacing="5"
        Orientation="Vertical"/>
  </CollectionView.ItemsLayout>
  <CollectionView.ItemTemplate>
    <DataTemplate x:DataType="model:ContactItem">
      <local:ContactItemView>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup Name="CommonStates">
            <VisualState Name="Normal"/>
            <VisualState Name="Selected">
              <VisualState.Setters>
                <Setter Property="BackgroundColor"
                    Value="Transparent"/>
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
      </local:ContactItemView>
    </DataTemplate>
  </CollectionView.ItemTemplate>
</CollectionView>
