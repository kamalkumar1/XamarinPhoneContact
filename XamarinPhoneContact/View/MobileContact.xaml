<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:maui="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:XamarinPhoneContact.ViewModel"
    xmlns:model="clr-namespace:XamarinPhoneContact.Helper"
    x:DataType="vm:KKContactViewModel"
    x:Class="XamarinPhoneContact.View.MobileContact">
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0"
                  Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button IsVisible="False"
                        x:Name="clearButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="15"
                        FontAttributes="Bold"
                        Margin="0"
                        Padding="0,0,0,0"
                        Text="Clear All">
                </Button>
                <Image x:Name="dismisbutton"
                       Aspect="AspectFit"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,10,10,15"
                       HeightRequest="25"
                       WidthRequest="25">

                </Image>
                <Button x:Name="dismisbuttonText"
                        Margin="0,5,10,5"
                        Grid.Row="2"
                        Grid.Column="1"
                        FontSize="15"
                        FontAttributes="Bold"></Button>
            </Grid>
            <SearchBar x:Name="searchText"
                       BackgroundColor="White"
                       Grid.Row="1"
                       Grid.Column="0">
            </SearchBar>
            <CollectionView
                IsGrouped="True"
                Grid.Row="2"
                VerticalScrollBarVisibility="Never"
                Grid.Column="0"
                RemainingItemsThreshold="5"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                ItemsSource="{Binding ContactGroups}"
                x:Name="contactList">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="5"
                                       Orientation="Vertical"/>
                </CollectionView.ItemsLayout>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="model:ContactGroup">
                        <Grid Padding="8"
                              BackgroundColor="#EEEEEE">
                            <Label FontSize="18"
                                   Text="{Binding Title}"
                                   FontAttributes="Bold"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ContactItem">
                        <Border
                            Margin="10,0,10,0"
                            Padding="0"
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#CCCCCC">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Grid
                                RowSpacing="0"
                                ColumnSpacing="0"
                                Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout HeightRequest="80"
                                             Spacing="0"
                                             Grid.Row="0"
                                             Grid.Column="0">
                                    <Label HeightRequest="40"
                                           Padding="10,10,0,10"
                                           TextColor="Black"
                                           Text="{Binding DisplayName}"
                                           FontAttributes="Bold"
                                           FontSize="16"/>
                                    <Label HeightRequest="40"
                                           Padding="10,10,0,10"
                                           Text="{Binding  GetPhones[0].PhoneNumber}"
                                           FontSize="14"/>
                                </StackLayout>
                                <!-- <Image HeightRequest="20"
                                       WidthRequest="20"
                                       Margin="5,5,20,0"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       IsVisible="{Binding Itemselcted}"
                                       Source="checkmark"
                                       Aspect="AspectFit"></Image> -->


                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <StackLayout Grid.Row="3"
                         Grid.Column="0"
                         x:Name="bottomLayout"
                         IsVisible="{Binding Itemselcted}"
                         Padding="0">
                <Label x:Name="LblLoadingText"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"
                       Padding="0,12,0,12"
                       FontAttributes="Bold"
                       FontSize="Medium"></Label>
            </StackLayout>
        </Grid>

    </ContentPage.Content>
</ContentPage>